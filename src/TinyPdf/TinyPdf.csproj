<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>0.2.0</Version>
    <PackageId>TinyPdf</PackageId>
    <Authors>Ian Cowley</Authors>
    <Description>TinyPdf is a minimal, zero-dependency, Native AOT-compatible PDF generation library targeting .NET 10.</Description>
    <PackageTags>pdf;tiny;pdf-generator;aot;net10;glacier</PackageTags>
    <RepositoryUrl>https://github.com/ian-cowley/tinypdf-csharp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ian-cowley/tinypdf-csharp</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>NuGetREADME.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TinyPdf.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="NuGetREADME.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="TinyPdfCreate.Builder.cs">
      <DependentUpon>TinyPdfCreate.cs</DependentUpon>
    </Compile>
    <Compile Update="TinyPdfCreate.Builder.PageContextImpl.cs">
      <DependentUpon>TinyPdfCreate.Builder.cs</DependentUpon>
    </Compile>
    <Compile Update="TinyPdfCreate.IPageContext.cs">
      <DependentUpon>TinyPdfCreate.cs</DependentUpon>
    </Compile>
    <Compile Update="TinyPdfCreate.Models.cs">
      <DependentUpon>TinyPdfCreate.cs</DependentUpon>
    </Compile>
    <Compile Update="TinyPdfCreate.PdfObject.cs">
      <DependentUpon>TinyPdfCreate.cs</DependentUpon>
    </Compile>
    <Compile Update="TinyPdfCreate.PooledBufferStream.cs">
      <DependentUpon>TinyPdfCreate.cs</DependentUpon>
    </Compile>
    <Compile Update="TinyPdfCreate.PooledBufferWriter.cs">
      <DependentUpon>TinyPdfCreate.cs</DependentUpon>
    </Compile>
    <Compile Update="TinyPdfCreate.Ref.cs">
      <DependentUpon>TinyPdfCreate.cs</DependentUpon>
    </Compile>
    <Compile Update="TinyPdfCreate.PdfFont.cs">
      <DependentUpon>TinyPdfCreate.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
